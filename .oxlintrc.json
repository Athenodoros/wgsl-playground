{
    "$schema": "./node_modules/oxlint/configuration_schema.json",
    "plugins": ["eslint", "typescript", "react", "oxc", "unicorn", "import", "vitest"],
    "categories": {
        "correctness": "error",
        "suspicious": "error",
        "perf": "error"
    },
    "env": {
        "browser": true,
        "es2020": true
    },
    "ignorePatterns": ["dist"],
    "rules": {
        // From ESLint's and typescript-eslint's recommended sets, which the categories above don't cover
        "no-array-constructor": "error",
        "no-case-declarations": "error",
        "no-empty": "error",
        "no-fallthrough": "error",
        "no-prototype-builtins": "error",
        "no-regex-spaces": "error",
        "no-useless-assignment": "error",
        "no-var": "error",
        "prefer-const": "error",
        "prefer-rest-params": "error",
        "prefer-spread": "error",
        "typescript/ban-ts-comment": "error",
        "typescript/no-empty-object-type": "error",
        "typescript/no-explicit-any": "error",
        "typescript/no-namespace": "error",
        "typescript/no-require-imports": "error",
        "typescript/no-unsafe-function-type": "error",
        "no-unused-vars": [
            "error",
            { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_", "caughtErrorsIgnorePattern": "^_" }
        ],

        // React: the rules of hooks, and fast refresh needing component-only files
        "react/rules-of-hooks": "error",
        "react/exhaustive-deps": "warn",
        "react/unsupported-syntax": "warn",
        "react/only-export-components": ["warn", { "allowConstantExport": true }],

        // Off: wrong for this setup, or flags patterns the code uses on purpose
        "react/react-in-jsx-scope": "off", // the JSX transform doesn't need React in scope
        "import/no-unassigned-import": "off", // CSS is imported for its side effect
        "no-shadow": "off", // values are built in a callback and returned under the same name
        "unicorn/consistent-function-scoping": "off", // tests keep small helpers next to their cases
        "unicorn/no-array-reverse": "off", // toReversed() is ES2023, past this project's ES2020 target
        "oxc/no-map-spread": "off" // spreading in map() keeps state updates immutable
    }
}
