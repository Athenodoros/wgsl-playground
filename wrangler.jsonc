// Deployed by Cloudflare Workers Builds on every push to main.
// The site is static: no Worker script, just the Vite build output.
{
    "name": "wgsl-playground",
    "compatibility_date": "2026-10-10",
    "assets": {
        "directory": "./dist"
    },
    // Lets Workers Builds deploy a preview of each non-main branch (via `wrangler preview`)
    "previews": {}
}
